{
  "name": "BillionaireCityTycoon",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "Templates": {
        "$path": "src/assets"
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "FilteringEnabled": true,
        "Gravity": 196.2
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [512, 1, 512],
          "Position": [0, -0.5, 0],
          "Material": "Grass",
          "BrickColor": "Bright green",
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [24, 1, 24],
          "Position": [0, 0.5, 0],
          "Neutral": true,
          "Transparency": 1,
          "CanCollide": false,
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [0.35, 0.37, 0.43],
        "OutdoorAmbient": [0.53, 0.53, 0.6],
        "ClockTime": 14.5,
        "Brightness": 2.5,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0.35,
        "EnvironmentSpecularScale": 0.35
      }
    },

    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ScreenOrientation": "Sensor",
        "ResetPlayerGuiOnSpawn": false,
        "IgnoreGuiInset": true
      }
    },

    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 5
      }
    }
  }
}
