--!strict
local Framework = require(script.Parent.Parent.Framework)
local NumberFormat = require(script.Parent.Parent.Parent.src.shared.Core.NumberFormat)

Framework.test("short formats small numbers exactly", function()
	Framework.equal(NumberFormat.short(0), "0")
	Framework.equal(NumberFormat.short(7), "7")
	Framework.equal(NumberFormat.short(999), "999")
	Framework.equal(NumberFormat.short(-42), "-42")
end)

Framework.test("short uses the K/M/B/T ladder", function()
	Framework.equal(NumberFormat.short(1000), "1K")
	Framework.equal(NumberFormat.short(1500), "1.5K")
	Framework.equal(NumberFormat.short(1_000_000), "1M")
	Framework.equal(NumberFormat.short(2_500_000_000), "2.5B")
	Framework.equal(NumberFormat.short(1e12), "1T")
	Framework.equal(NumberFormat.short(1e15), "1Qa")
	Framework.equal(NumberFormat.short(1e18), "1Qi")
end)

Framework.test("short never prints 1000K after rounding", function()
	Framework.equal(NumberFormat.short(999_999), "1M")
	Framework.equal(NumberFormat.short(999_950), "1M")
end)

Framework.test("money prefixes the currency symbol", function()
	Framework.equal(NumberFormat.money(1500), "$1.5K")
	Framework.equal(NumberFormat.money(250), "$250")
end)

Framework.test("full groups thousands", function()
	Framework.equal(NumberFormat.full(1234567), "1,234,567")
	Framework.equal(NumberFormat.full(999), "999")
	Framework.equal(NumberFormat.full(1000), "1,000")
	Framework.equal(NumberFormat.full(-5000), "-5,000")
	Framework.equal(NumberFormat.full(1234, "$"), "$1,234")
end)

Framework.test("percent and duration are readable", function()
	Framework.equal(NumberFormat.percent(0.127), "12.7%")
	Framework.equal(NumberFormat.percent(1), "100.0%")
	Framework.equal(NumberFormat.duration(0), "0s")
	Framework.equal(NumberFormat.duration(45), "45s")
	Framework.equal(NumberFormat.duration(125), "2m 5s")
	Framework.equal(NumberFormat.duration(3725), "1h 2m")
	Framework.equal(NumberFormat.duration(90_000), "1d 1h")
end)
