--!strict
local Framework = require(script.Parent.Parent.Framework)
local Money = require(script.Parent.Parent.Parent.src.shared.Core.Money)

Framework.test("Money rejects non-finite values", function()
	Framework.isFalse(Money.isFinite(0 / 0), "NaN")
	Framework.isFalse(Money.isFinite(math.huge), "inf")
	Framework.isFalse(Money.isFinite(-math.huge), "-inf")
	Framework.isFalse(Money.isFinite("12"), "string")
	Framework.isTrue(Money.isFinite(12))
end)

Framework.test("Money accepts safe integers only", function()
	Framework.isTrue(Money.isSafeInteger(0))
	Framework.isTrue(Money.isSafeInteger(-42))
	Framework.isFalse(Money.isSafeInteger(1.5), "fractional")
	Framework.isFalse(Money.isSafeInteger(2 ^ 53 + 2), "beyond 2^53")
end)

Framework.test("Money.round rounds halves away from zero and saturates", function()
	Framework.equal(Money.round(1.4), 1)
	Framework.equal(Money.round(1.5), 2)
	Framework.equal(Money.round(-1.5), -2)
	Framework.equal(Money.round(math.huge), 0)
	Framework.equal(Money.round(2 ^ 60), 2 ^ 53)
end)

Framework.test("Money.toAmount rejects negative and fractional amounts", function()
	Framework.equal(Money.toAmount(100), 100)
	Framework.equal(Money.toAmount(-1), nil)
	Framework.equal(Money.toAmount(1.25), nil)
	Framework.equal(Money.toAmount(0 / 0), nil)
end)

Framework.test("Money arithmetic saturates instead of overflowing", function()
	Framework.equal(Money.add(2 ^ 53, 2 ^ 53), 2 ^ 53)
	Framework.equal(Money.sub(10, 20), 0)
	Framework.equal(Money.clamp(-5), 0)
end)

Framework.test("Money.canAfford handles boundaries", function()
	Framework.isTrue(Money.canAfford(500, 500))
	Framework.isFalse(Money.canAfford(499, 500))
	Framework.isFalse(Money.canAfford(500, -5))
end)
