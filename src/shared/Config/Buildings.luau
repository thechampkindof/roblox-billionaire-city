--!strict
--[[
	Building definitions — Starter District.

	Data only. Systems never mention a specific building: they read `archetype`,
	`phases`, income fields and the generated upgrade lines. Phase 1 exercises this with
	the Convenience Store; Phase 2 adds the remaining Starter buildings' hand-tuned
	content and the other seven districts (see `docs/ROADMAP.md`).

	Costs are integers. `buildCost` is the sum of the phase costs and is used by the
	content validator and the simulator, not charged twice by the server.
]]

local Types = require(script.Parent.Parent.Core.Types)

local Buildings = {}

export type BuildingDef = Types.BuildingDef

local function phase(
	id: string,
	name: string,
	cost: number,
	seconds: number,
	visual: string
): Types.PhaseDef
	return {
		id = id,
		name = name,
		cost = { cash = cost },
		seconds = seconds,
		requires = {},
		visual = visual,
	}
end

local function building(def: Types.BuildingDef): Types.BuildingDef
	return def
end

